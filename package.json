{
  "name": "uberlog",
  "version": "0.1.0",
  "author": "ido roseman 4x6ub",
  "description": "ham radio log program that looks good",
  "main": "src/electron.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build-dev": "REACT_APP_ENV=staging npm run build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start-electron": "concurrently -k \"BROWSER=none npm start\" \"npm:electron\"",
    "electron": "wait-on tcp:3000 && electron-forge start",
    "electron-old": "wait-on tcp:3000 && electron .",
    "package": "react-scripts build && electron-forge package",
    "make": "react-scripts build && electron-forge make",
    "make-mac-arm64": "react-scripts build && electron-forge make --platform=darwin --arch=arm64",
    "make-mac-x64": "react-scripts build && electron-forge make --platform=darwin --arch=x64",
    "make-mac-all": "npm run make-mac-x64 && npm run make-mac-arm64",
    "make-win": "react-scripts build && electron-forge make --platform=win32 --arch=x64",
    "icon-maker": "npx electron-icon-maker --input=/absolute/path/to/cra-electron-forge-demo/src/app-icon.png --output=src  "
  },
  "build": {
    "appId": "com.idoroseman.uberlog",
    "extends": null
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.16",
    "@mui/lab": "^5.0.0-alpha.16",
    "@mui/material": "^5.14.16",
    "@mui/styles": "^5.14.16",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@vis.gl/react-google-maps": "^1.10.0",
    "ajv": "^8.12.0",
    "chart.js": "^4.4.1",
    "electron-is-dev": "^2.0.0",
    "electron-squirrel-startup": "^1.0.0",
    "firebase": "^10.7.0",
    "is-electron": "^2.2.2",
    "julian-date": "^1.0.1",
    "moment": "^2.29.4",
    "react": "18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "18.3.1",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "react-virtualized-auto-sizer": "^1.0.7",
    "react-window": "^1.8.10",
    "react-world-flags": "^1.4.0",
    "web-vitals": "^3.3.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.4.2",
    "@electron-forge/maker-deb": "^6.4.2",
    "@electron-forge/maker-rpm": "^6.4.2",
    "@electron-forge/maker-squirrel": "^6.4.2",
    "@electron-forge/maker-zip": "^6.4.2",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-devtools-installer": "^3.2.0",
    "wait-on": "^7.2.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon-mac": "src/icons/mac/icon.icns",
        "icon": "src/icons/win/icon.ico",
        "name": "UberLog"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "uberlog_nx"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
